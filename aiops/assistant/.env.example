# 复制为 .env 后填写
# === LLM 配置 (OpenAI / DeepSeek / 本地 Ollama) ===
LLM_API_KEY=sk-your-key-here
# DeepSeek:
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 若用本地 Ollama，改 base_url 为 http://<ollama-host>:11434/v1，model=qwen2.5:7b，key 随意

# === 可观测性组件地址（在集群内可用 Service DNS）===
LOKI_URL=http://loki.monitoring:3100
PROM_URL=http://prometheus.monitoring:9090
